theorem not_semiprime_of_eq_mul_three
    {n x y z : ℕ} (hn : n = x * y * z)
    (hx : 1 < x) (hy : 1 < y) (hz : 1 < z) :
    ¬n.IsSemiprime := by
  intro hsemi
  rw [hn] at hsemi
  have hxΩ : 0 < ArithmeticFunction.cardFactors x :=
    ArithmeticFunction.cardFactors_pos_iff_one_lt.mpr hx
  have hyΩ : 0 < ArithmeticFunction.cardFactors y :=
    ArithmeticFunction.cardFactors_pos_iff_one_lt.mpr hy
  have hzΩ : 0 < ArithmeticFunction.cardFactors z :=
    ArithmeticFunction.cardFactors_pos_iff_one_lt.mpr hz
  have hcard := hsemi.2
  rw [ArithmeticFunction.cardFactors_mul (by positivity : x * y ≠ 0)
      (by omega : z ≠ 0),
    ArithmeticFunction.cardFactors_mul (by omega : x ≠ 0) (by omega : y ≠ 0)] at hcard
  omega

